{
  "name": "pagenarrator",
  "version": "1.0.2",
  "private": true,
  "description": "PageNarrator: Chrome extension that reads any web page aloud using on-device Kokoro TTS.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixCAxO/PageNarrator.git"
  },
  "homepage": "https://pagenarrator.com/chrome-extension",
  "bugs": "https://github.com/FelixCAxO/PageNarrator/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:website": "cd website && wrangler pages dev public",
    "build:website": "node scripts/build-website-assets.mjs && node scripts/build-localized-website.mjs && node scripts/build-website.mjs",
    "predeploy:website": "npm run build:website",
    "deploy:website": "wrangler pages deploy artifacts/website --project-name=pagenarrator-site --branch=main",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:benchmarks": "eslint scripts/benchmarks/*.mjs tests/benchmarks/*.mjs && node --test tests/benchmarks/harness.test.mjs tests/benchmarks/homepage-css.test.mjs tests/benchmarks/website-layout.test.mjs tests/benchmarks/kokoro.test.mjs",
    "test:core": "vitest run tests/ci",
    "test:reader": "vitest run tests/reader",
    "test:platform": "vitest run tests/platform",
    "test:build": "vitest run tests/build",
    "test:host-layout": "vitest run tests/ci/host-page-layout-safety.test.js",
    "test:pdf": "vitest run tests/pdf --exclude tests/pdf/pdf-real-corpus.test.js",
    "test:reader-engine": "vitest run tests/reader-engine",
    "test:speech": "vitest run tests/speech",
    "test:voice": "vitest run tests/voice",
    "test:tts": "vitest run tests/tts",
    "test:website": "vitest run tests/website",
    "test:cws-media": "node scripts/audit-cws-media-text.mjs",
    "capture:cws-media": "node scripts/capture-current-product-media.mjs",
    "test:reading": "vitest run tests/reading",
    "test:profiles": "vitest run --config vitest.profiles.config.js",
    "test:e2e": "node scripts/test-github-release.mjs",
    "test:e2e:local": "playwright test",
    "test:models": "node scripts/download-test-models.mjs",
    "test:e2e:real-model": "cross-env PN_E2E_REAL_MODEL=1 playwright test --project=real-model",
    "test:live": "npm run build && npm run test:live:no-build",
    "test:live:no-build": "node scripts/run-live-tests.mjs",
    "probe:tts": "npm run build && npm run probe:tts:no-build",
    "probe:tts:no-build": "node scripts/run-live-tts-probe.mjs",
    "probe:tts:lower-spec": "npm run build && npm run probe:tts:lower-spec:no-build",
    "probe:tts:lower-spec:no-build": "cross-env PAGENARRATOR_TTS_PROBE_PROFILE=lower-spec node scripts/run-live-tts-probe.mjs",
    "probe:tts:lower-spec-pdf": "npm run build && npm run probe:tts:lower-spec-pdf:no-build",
    "probe:tts:lower-spec-pdf:no-build": "cross-env PAGENARRATOR_TTS_PROBE_PROFILE=4gb_4cpu_low_memory PAGENARRATOR_TTS_PROBE_DOCUMENTS=pdf PAGENARRATOR_TTS_PROBE_MAX_WORKERS=1 node scripts/run-live-tts-probe.mjs",
    "probe:tts:requirements": "npm run build && cross-env PAGENARRATOR_TTS_PROBE_PROFILE=requirements node scripts/run-live-tts-probe.mjs && npm run requirements:tts",
    "requirements:tts": "node scripts/summarize-tts-requirements.mjs",
    "probe:weak-hardware": "npm run build && npm run probe:weak-hardware:no-build",
    "probe:weak-hardware:no-build": "node scripts/weak-hardware/run-matrix.mjs",
    "test:weak-hardware": "vitest run tests/weak-hardware",
    "measurement:lock": "node scripts/weak-hardware/measurement-lock.mjs",
    "beta:scorecard": "node scripts/summarize-closed-beta.mjs",
    "probe:tts:deep": "npm run build && cross-env PAGENARRATOR_TTS_PROBE_PROFILE=deep-flow node scripts/run-live-tts-probe.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "test:pdf-corpus": "node scripts/test-original-pdf-corpus.mjs",
    "prepare:pdf-gold": "node scripts/build-pdf-library-gold.mjs",
    "test:pdf-acceptance": "cross-env PN_PDF_LIBRARY_ACCEPTANCE=1 vitest run tests/pdf/pdf-library-acceptance.test.js",
    "test:pdf-acceptance:historical": "cross-env PN_PDF_ACCEPTANCE=1 vitest run tests/pdf/pdf-acceptance.test.js",
    "report:pdf-acceptance": "node scripts/run-pdf-acceptance.mjs --write-report",
    "test:summer2026-pdfs": "cross-env PN_SUMMER2026_PDF_CORPUS=1 vitest run tests/pdf/pdf-summer2026-corpus.test.js",
    "build:native": "node scripts/build-native-kernels.mjs",
    "prebuild": "node scripts/build-native-kernels.mjs --check && node scripts/build-native-engine.mjs --check && node scripts/check-browser-engine-artifacts.mjs",
    "build:phonemizer": "node scripts/build-browser-phonemizer.mjs",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.strict.json",
    "typecheck:boundaries": "tsc -p tsconfig.boundaries.json",
    "lint": "eslint .",
    "clean": "node scripts/clean.mjs",
    "profile:memory": "node --expose-gc scripts/profile-memory-usage.mjs",
    "check:reader-engine-composition": "node scripts/check-reader-engine-composition.mjs",
    "check:repo-structure": "node scripts/check-repo-structure.mjs",
    "verify:fast": "node scripts/run-verification-gate.mjs fast",
    "verify:integration": "node scripts/run-verification-gate.mjs integration",
    "verify:release": "node scripts/run-verification-gate.mjs release",
    "verify:manual-live": "node scripts/run-verification-gate.mjs manual-live",
    "launch:full": "npm run verify:release",
    "prelaunch": "npm run launch:full && npm run smoke:production",
    "package": "npm run build && node scripts/assert-release-package.mjs dist && node scripts/package-release.mjs dist",
    "deploy:support-mailbox": "wrangler deploy -c website/workers/support-mailbox.wrangler.jsonc",
    "preview": "node scripts/preview.mjs",
    "preview:website": "preview-website.bat"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "protobufjs": ">=7.6.5 <8",
    "sharp": "$sharp",
    "tar": "^7.5.22",
    "onnxruntime-node": "^1.30.0",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@playwright/test": "^1.60.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "cross-env": "^7.0.3",
    "cross-spawn": "^7.0.6",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.0",
    "onnxruntime-web-omnivoice": "npm:onnxruntime-web@1.25.0-dev.20260227-dce58e8711",
    "playwright": "1.60.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.87.0",
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "^1.2.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "pdfjs-dist": "^6.2.108"
  }
}
