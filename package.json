{
  "name": "pagenarrator",
  "version": "1.0.5",
  "private": true,
  "description": "Free, open-source text-to-speech extension for Chrome and Chromium. Read webpages and PDFs aloud with on-device AI voices. No account or usage quota.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixCAxO/PageNarrator.git"
  },
  "homepage": "https://pagenarrator.com/chrome-extension",
  "bugs": "https://github.com/FelixCAxO/PageNarrator/issues",
  "type": "module",
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "vite --config tooling/vite.config.js",
    "dev:website": "cd website && wrangler pages dev public",
    "build:website": "node tooling/scripts/build-website-assets.mjs && node tooling/scripts/build-localized-website.mjs && node tooling/scripts/build-website.mjs",
    "predeploy:website": "npm run build:website",
    "deploy:website": "wrangler pages deploy artifacts/website --project-name=pagenarrator-site --branch=main",
    "test": "vitest run --config tooling/vite.config.js",
    "test:ci": "vitest run --config tooling/vite.config.js",
    "test:benchmarks": "eslint --config tooling/eslint.config.js tooling/scripts/benchmarks/*.mjs tests/benchmarks/*.mjs && node --test tests/benchmarks/harness.test.mjs tests/benchmarks/homepage-css.test.mjs tests/benchmarks/website-layout.test.mjs tests/benchmarks/kokoro.test.mjs",
    "test:core": "vitest run --config tooling/vite.config.js tests/ci",
    "test:reader": "vitest run --config tooling/vite.config.js tests/reader",
    "test:platform": "vitest run --config tooling/vite.config.js tests/platform",
    "test:build": "vitest run --config tooling/vite.config.js tests/build",
    "test:host-layout": "vitest run --config tooling/vite.config.js tests/ci/host-page-layout-safety.test.js",
    "test:pdf": "vitest run --config tooling/vite.config.js tests/pdf --exclude tests/pdf/pdf-real-corpus.test.js",
    "test:reader-engine": "vitest run --config tooling/vite.config.js tests/reader-engine",
    "test:speech": "vitest run --config tooling/vite.config.js tests/speech",
    "test:voice": "vitest run --config tooling/vite.config.js tests/voice",
    "test:tts": "vitest run --config tooling/vite.config.js tests/tts",
    "test:website": "vitest run --config tooling/vite.config.js tests/website",
    "test:cws-media": "node tooling/scripts/audit-cws-media-text.mjs",
    "capture:cws-media": "node tooling/scripts/capture-current-product-media.mjs",
    "test:reading": "vitest run --config tooling/vite.config.js tests/reading",
    "test:profiles": "vitest run --config tooling/vitest.profiles.config.js",
    "test:e2e": "node tooling/scripts/test-github-release.mjs",
    "test:e2e:local": "playwright test --config tooling/playwright.config.js",
    "test:models": "node tooling/scripts/download-test-models.mjs",
    "test:e2e:real-model": "cross-env PN_E2E_REAL_MODEL=1 playwright test --config tooling/playwright.config.js --project=real-model",
    "test:e2e:omnivoice": "node tooling/scripts/run-omnivoice-release-tests.mjs",
    "test:live": "npm run build && npm run test:live:no-build",
    "test:live:no-build": "node tooling/scripts/run-live-tests.mjs",
    "probe:tts": "npm run build && npm run probe:tts:no-build",
    "probe:tts:no-build": "node tooling/scripts/run-live-tts-probe.mjs",
    "probe:tts:lower-spec": "npm run build && npm run probe:tts:lower-spec:no-build",
    "probe:tts:lower-spec:no-build": "cross-env PAGENARRATOR_TTS_PROBE_PROFILE=lower-spec node tooling/scripts/run-live-tts-probe.mjs",
    "probe:tts:lower-spec-pdf": "npm run build && npm run probe:tts:lower-spec-pdf:no-build",
    "probe:tts:lower-spec-pdf:no-build": "cross-env PAGENARRATOR_TTS_PROBE_PROFILE=4gb_4cpu_low_memory PAGENARRATOR_TTS_PROBE_DOCUMENTS=pdf PAGENARRATOR_TTS_PROBE_MAX_WORKERS=1 node tooling/scripts/run-live-tts-probe.mjs",
    "probe:tts:requirements": "npm run build && cross-env PAGENARRATOR_TTS_PROBE_PROFILE=requirements node tooling/scripts/run-live-tts-probe.mjs && npm run requirements:tts",
    "requirements:tts": "node tooling/scripts/summarize-tts-requirements.mjs",
    "probe:weak-hardware": "npm run build && npm run probe:weak-hardware:no-build",
    "probe:weak-hardware:no-build": "node tooling/scripts/weak-hardware/run-matrix.mjs",
    "test:weak-hardware": "vitest run --config tooling/vite.config.js tests/weak-hardware",
    "measurement:lock": "node tooling/scripts/weak-hardware/measurement-lock.mjs",
    "probe:tts:deep": "npm run build && cross-env PAGENARRATOR_TTS_PROBE_PROFILE=deep-flow node tooling/scripts/run-live-tts-probe.mjs",
    "smoke:production": "node tooling/scripts/smoke-production.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "test:pdf-corpus": "node tooling/scripts/test-original-pdf-corpus.mjs",
    "probe:pdf-document": "node tooling/scripts/probe-pdf-document.mjs",
    "prepare:pdf-gold": "node tooling/scripts/build-pdf-library-gold.mjs",
    "test:pdf-acceptance": "cross-env PN_PDF_LIBRARY_ACCEPTANCE=1 vitest run --config tooling/vite.config.js tests/pdf/pdf-library-acceptance.test.js",
    "test:pdf-acceptance:historical": "cross-env PN_PDF_ACCEPTANCE=1 vitest run --config tooling/vite.config.js tests/pdf/pdf-acceptance.test.js",
    "report:pdf-acceptance": "node tooling/scripts/run-pdf-acceptance.mjs --write-report",
    "test:summer2026-pdfs": "cross-env PN_SUMMER2026_PDF_CORPUS=1 vitest run --config tooling/vite.config.js tests/pdf/pdf-summer2026-corpus.test.js",
    "build:native": "node tooling/scripts/build-native-kernels.mjs",
    "prebuild": "node tooling/scripts/build-native-kernels.mjs --check && node tooling/scripts/build-native-engine.mjs --check && node tooling/scripts/check-browser-engine-artifacts.mjs && node tooling/scripts/write-omnivoice-preset-seeds.mjs --check",
    "build:phonemizer": "node tooling/scripts/build-browser-phonemizer.mjs",
    "build": "vite build --config tooling/vite.config.js",
    "typecheck": "tsc -p tooling/tsconfig.strict.json",
    "typecheck:boundaries": "tsc -p tooling/tsconfig.boundaries.json",
    "lint": "eslint --config tooling/eslint.config.js .",
    "clean": "node tooling/scripts/clean.mjs",
    "profile:memory": "node --expose-gc tooling/scripts/profile-memory-usage.mjs",
    "check:reader-engine-composition": "node tooling/scripts/check-reader-engine-composition.mjs",
    "check:repo-structure": "node tooling/scripts/check-repo-structure.mjs",
    "verify:fast": "node tooling/scripts/run-verification-gate.mjs fast",
    "verify:integration": "node tooling/scripts/run-verification-gate.mjs integration",
    "verify:release": "node tooling/scripts/run-verification-gate.mjs release",
    "verify:manual-live": "node tooling/scripts/run-verification-gate.mjs manual-live",
    "launch:full": "npm run verify:release",
    "prelaunch": "npm run launch:full && npm run smoke:production",
    "package": "npm run build && node tooling/scripts/assert-release-package.mjs dist && node tooling/scripts/package-release.mjs dist",
    "deploy:support-mailbox": "wrangler deploy -c website/workers/support-mailbox.wrangler.jsonc",
    "preview": "node tooling/scripts/preview.mjs",
    "preview:website": "cmd /d /c tooling\\scripts\\preview-website.bat"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "protobufjs": ">=7.6.6 <8",
    "sharp": "$sharp",
    "tar": "^7.5.22",
    "onnxruntime-node": "^1.31.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@huggingface/transformers": "4.3.2",
    "@playwright/test": "^1.64.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.1.0",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "1.31.1",
    "onnxruntime-web-omnivoice": "npm:onnxruntime-web@1.31.1",
    "pdfjs-dist": "^6.4.299",
    "playwright": "1.64.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "tesseract.js@7.0.0": true,
    "workerd@1.20261023.1": true,
    "unrs-resolver@1.12.2": true,
    "onnxruntime-node@1.31.1": true,
    "protobufjs@7.6.6": true
  }
}
